{
  "name": "rdu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-deploy.mjs && next build",
    "start": "next start",
    "lint": "echo Lint is not configured in this workspace.",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
